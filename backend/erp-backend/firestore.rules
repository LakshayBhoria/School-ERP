rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function userDoc() { return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function role() { return userDoc().data.role; }
    function company() { return userDoc().data.companyId; }
    function isAdmin() { return signedIn() && role() == 'admin'; }
    function isManager() { return signedIn() && (role() == 'admin' || role() == 'manager'); }
    function sameCompany(companyId) { return signedIn() && company() == companyId; }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isManager());
      allow write: if isAdmin();
    }

    match /companies/{companyId} {
      allow read: if sameCompany(companyId);
      allow write: if isAdmin() && sameCompany(companyId);

      match /employees/{employeeId} {
        allow read: if sameCompany(companyId);
        allow create, update, delete: if isManager() && sameCompany(companyId);
      }

      match /departments/{deptId} {
        allow read: if sameCompany(companyId);
        allow write: if isAdmin() && sameCompany(companyId);
      }

      match /attendance/{recordId} {
        allow read: if sameCompany(companyId);
        allow create, update: if signedIn() && sameCompany(companyId);
        allow delete: if isManager() && sameCompany(companyId);
      }

      match /leaves/{leaveId} {
        allow read: if sameCompany(companyId);
        allow create: if signedIn() && sameCompany(companyId);
        allow update: if isManager() && sameCompany(companyId);
        allow delete: if isManager() && sameCompany(companyId);
      }

      match /resources/{resourceId} {
        allow read: if sameCompany(companyId);
        allow write: if isManager() && sameCompany(companyId);
      }

      match /payrollRuns/{runId} {
        allow read: if isManager() && sameCompany(companyId);
        allow write: if isAdmin() && sameCompany(companyId);
      }

      match /settings/{docId} {
        allow read: if sameCompany(companyId);
        allow write: if isAdmin() && sameCompany(companyId);
      }
    }
  }
}
