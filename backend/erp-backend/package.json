{
  "name": "corvus-erp-backend",
  "version": "1.0.0",
  "description": "Corvus HR & Payroll ERP — Node.js/Express API on Firebase (Firestore + Cloud Functions + Auth)",
  "main": "index.js",
  "engines": { "node": "20" },
  "scripts": {
    "serve": "firebase emulators:start --only functions,firestore,auth",
    "shell": "firebase functions:shell",
    "start": "node index.js",
    "deploy": "firebase deploy --only functions,firestore:rules",
    "logs": "firebase functions:log"
  },
  "dependencies": {
    "express": "^4.19.2",
    "cors": "^2.8.5",
    "firebase-admin": "^12.3.0",
    "firebase-functions": "^5.0.1",
    "zod": "^3.23.8",
    "dotenv": "^16.4.5",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.4.0"
  },
  "private": true
}
